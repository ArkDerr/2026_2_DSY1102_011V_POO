<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.miprimerproyectojavafx.controller.MenuController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Label text="Mantenedor de Persona">
      <font>
         <Font name="Comic Sans MS Bold" size="30.0" />
      </font>
   </Label>
   <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
      <children>
          <Button fx:id="btnCrear" onAction="#onCrearButtonClick" prefWidth="150.0" text="Crear">
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin>
         </Button>
         <Button mnemonicParsing="false" prefWidth="150.0" text="Listar">
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin>
         </Button>
         <Button mnemonicParsing="false" prefWidth="150.0" text="Buscar">
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin>
         </Button>
         <Button mnemonicParsing="false" prefWidth="150.0" text="Editar">
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin>
         </Button>
         <Button mnemonicParsing="false" prefWidth="150.0" text="Elimnar">
            <VBox.margin>
               <Insets bottom="10.0" />
            </VBox.margin>
         </Button>
         <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#onSalirButonClick" prefWidth="150.0" text="Salir" />
      </children>
   </VBox>
</VBox>
