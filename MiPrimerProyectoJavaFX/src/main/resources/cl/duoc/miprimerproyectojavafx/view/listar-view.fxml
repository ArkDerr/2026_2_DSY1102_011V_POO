<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cl.duoc.miprimerproyectojavafx.controller.ListarController">
    <children>
        <Label layoutX="31.0" layoutY="23.0" text="Listar Persona">
            <font>
                <Font name="System Bold" size="30.0" />
            </font>
        </Label>
        <Pane layoutX="595.0" layoutY="527.0" prefHeight="45.0" prefWidth="184.0">
            <children>
                <Button fx:id="btnListarVolver" layoutX="66.0" layoutY="10.0" mnemonicParsing="false" onAction="#onVolverButtonClick" text="Volver" />
            </children>
        </Pane>
      <TableView fx:id="tblPersonas" layoutX="40.0" layoutY="93.0" prefHeight="423.0" prefWidth="704.0">
        <columns>
          <TableColumn fx:id="colRut" prefWidth="75.0" text="Rut" />
          <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="colApellido" prefWidth="75.0" text="Apellido" />
            <TableColumn fx:id="colFechaNacimiento" prefWidth="75.0" text="Fecha Nacimiento" />
            <TableColumn fx:id="colTipo" prefWidth="75.0" text="Tipo de Persona" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
    </children>

</AnchorPane>
